      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 10px;border:1px solid transparent;border-radius:2px;font-family:var(--font-sans,\"Geist Variable\",sans-serif);font-size:14px;font-weight:550;line-height:20px;text-decoration:none;cursor:pointer;transition:all .15s;box-shadow:none;background:color-mix(in oklab,var(--input,#514b3e) 30%,transparent);color:var(--foreground,#f5f3eb);border-color:var(--input,#514b3e);}.ds-button-outline:hover{background:color-mix(in oklab,var(--input,#514b3e) 50%,transparent);}.ds-button-outline:focus-visible{outline:none;border-color:var(--ring,#c2a66b)}.ds-button-outline:active{transform:translateY(1px)}.ds-button-outline:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-outline{transition:none}}"
    },
    {
