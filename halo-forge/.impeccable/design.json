      "refersTo": "button-ghost",
      "description": "Default-size shadcn action with final 2px corners and 44px minimum height.",
      "html": "<button class=\"ds-button-ghost\">View details</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 10px;border:1px solid transparent;border-radius:2px;font-family:var(--font-sans,\"Geist Variable\",sans-serif);font-size:14px;font-weight:550;line-height:20px;text-decoration:none;cursor:pointer;transition:all .15s;box-shadow:none;background:transparent;color:var(--foreground,#f5f3eb);}.ds-button-ghost:hover{background:color-mix(in oklab,var(--muted,#1b1b19) 50%,transparent);}.ds-button-ghost:focus-visible{outline:none;border-color:var(--ring,#c2a66b)}.ds-button-ghost:active{transform:translateY(1px)}.ds-button-ghost:disabled{opacity:.5;pointer-events:none}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none}}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Dark shadcn field with gold focus and responsive sizing.",
      "html": "<input class=\"ds-input\" aria-label=\"Agent name\" placeholder=\"Agent name\" />",
      "css": ".ds-input{width:100%;min-width:0;height:32px;padding:4px 10px;border:1px solid var(--input,#514b3e);border-radius:2px;background:color-mix(in oklab,var(--input,#514b3e) 30%,transparent);color:var(--foreground,#f5f3eb);font-family:var(--font-sans,\"Geist Variable\",sans-serif);font-size:16px;transition:color .15s,border-color .15s;caret-color:var(--primary,#f5f3ed)}.ds-input::placeholder{color:var(--muted-foreground,#a9a69e)}.ds-input:focus-visible{outline:none;border-color:var(--ring,#c2a66b);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#c2a66b) 50%,transparent)}.ds-input:disabled{opacity:.5;pointer-events:none}.ds-input[aria-invalid=true]{border-color:var(--destructive,#ff9a90)}@media(min-width:768px){.ds-input{font-size:14px}}@media(max-width:760px){.ds-input{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-input{transition:none}}"
    },
    {
      "name": "Masthead Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Desktop horizontal navigation with quiet gold current-page underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Preview navigation\"><a class=\"ds-nav-link\" href=\"#overview\" aria-current=\"page\">Overview</a><a class=\"ds-nav-link\" href=\"#agents\">Agents</a><a class=\"ds-nav-link\" href=\"#findings\">Findings</a></nav>",
      "css": ".ds-nav{display:flex;gap:6px;background:var(--background,#090909);font-family:var(--font-sans,\"Geist Variable\",sans-serif);}.ds-nav-link{display:flex;align-items:center;min-height:41px;padding:28px 10px;border-bottom:2px solid transparent;color:#b0aca4;font-size:12px;text-decoration:none;transition:background .16s,color .16s}.ds-nav-link[aria-current=page]{color:#f5f3eb;border-bottom-color:var(--gold,#c2a66b)}.ds-nav-link:hover{background:#191711;color:var(--foreground,#f5f3eb)}.ds-nav-link:focus-visible{outline:2px solid var(--primary,#f5f3ed);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none}}"
    },
    {
