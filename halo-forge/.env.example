# Copy to .env.local for local preview. Never enable preview on a public host.
HALO_LOCAL_PREVIEW=true
HALO_APP_ORIGIN=http://127.0.0.1:3210
# Absolute path optional. Defaults to .data/halo.sqlite.
HALO_DATABASE_PATH=
# Comma-separated verified reviewer wallet public keys. Empty denies reviewer actions.
HALO_REVIEWER_WALLETS=
# Model/treasury secrets never belong in NEXT_PUBLIC variables.

# sqlite for local-only development; postgres for Supabase (never public env vars).
HALO_DATABASE_DRIVER=sqlite
# Restricted halo_app database role; percent-encode special characters.
HALO_DATABASE_URL=
# Supabase's public root certificate, downloaded from project database settings.
HALO_DATABASE_CA_PATH=certs/supabase-ca.crt
